# Copy to .env.local. For local development run `npx supabase start` and use the values it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used for links in auth emails (sign-up confirmation, magic links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
